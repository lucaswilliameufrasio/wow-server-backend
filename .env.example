# AzerothCore MySQL (within Docker network: hostname = ac-database)
AZEROTH_CORE_MYSQL_DATABASE_URL=mysql://root:password@ac-database:3306

# App PostgreSQL (host for Docker Compose: hostname = app-postgres)
APP_POSTGRES_DATABASE_URL=postgres://postgres:password@app-postgres:5432/wow_app

# JWT keys — use PATH (file) or PEM (inline content)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# JWT config
JWT_ISSUER=wow-backend
JWT_AUDIENCE=wow-web
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=30

# AzerothCore database names inside MySQL
AZEROTH_CORE_AUTH_DB=acore_auth
AZEROTH_CORE_CHARACTERS_DB=acore_characters
AZEROTH_CORE_WORLD_DB=acore_world

# AzerothCore worldserver SOAP (admin commands; disabled when password is empty)
AZEROTH_CORE_SOAP_HOST=ac-worldserver
AZEROTH_CORE_SOAP_PORT=7878
AZEROTH_CORE_SOAP_USER=wowctl
# AZEROTH_CORE_SOAP_PASSWORD=

# DANGEROUS: raw GM command endpoint (POST /v1/admin/server/command).
# Disabled by default; keep off unless you understand the impact.
WOW_ENABLE_GM_COMMANDS=false
# Optional allowlist (comma-separated prefixes), e.g. "server info,reload config"
# WOW_GM_COMMAND_ALLOWLIST=

# Optional: directory with worldserver Server.log/Crash.log for the
# /v1/admin/server/logs and /v1/admin/server/crashes endpoints
# AZEROTH_CORE_LOGS_DIR=/opt/azerothcore-wotlk/env/dist/logs

# Backend port (defaults to 3000)
PORT=3000

# Prometheus metrics server (separate, private port — binds 127.0.0.1 by default)
METRICS_PORT=9090
# METRICS_BIND=127.0.0.1

# SRP6 mode (true for AzerothCore v5+)
SRP6_CORE5_MODE=false

# Rate limit on register/sign-in (per-IP). Set to false to disable (defaults to true)
WOW_RATE_LIMIT=true

# Expose /debug/diagnostics (off by default)
# WOW_DEBUG_ENABLED=true
