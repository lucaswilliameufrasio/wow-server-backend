# =============================================================================
# WoW Server Backend — VPS Docker Compose Configuration
# =============================================================================
# Copy this file to .env and edit before running `./wowctl install`.
#   cp .env.example .env && nano .env
# =============================================================================

# --- PostgreSQL (API) --------------------------------------------------------
WOW_PG_PASSWORD=CHANGE_ME_GENERATE_32_CHARS
WOW_PG_USER=wow_api
WOW_PG_DB=wow_app

# --- MySQL (AzerothCore) -----------------------------------------------------
WOW_MYSQL_PASSWORD=CHANGE_ME_GENERATE_32_CHARS

# --- SOAP (worldserver, used by `./wowctl reload` and admin endpoints) -------
# Auto-generated by `./wowctl install`; only edit if you know what you are doing.
WOW_SOAP_PASSWORD=CHANGE_ME_GENERATE_32_CHARS
WOW_SOAP_USER=wowctl
WOW_SOAP_PORT=7878

# DANGEROUS: raw GM command endpoint (POST /v1/admin/server/command).
WOW_ENABLE_GM_COMMANDS=false
# WOW_GM_COMMAND_ALLOWLIST="server info,reload config"

# --- API ---------------------------------------------------------------------
WOW_API_PORT=3000
WOW_RUST_LOG=info
# Prometheus metrics (internal only — not published by compose; scrape from the
# docker network or use `docker compose exec wow-backend wget -O- 127.0.0.1:9090/metrics`)
WOW_METRICS_PORT=9090
# SRP6 verifier format: false = AzerothCore master (default), true = "core 5" (outros cores).
# Se login falhar com "invalid password", confira que está false e recrie a conta.
WOW_SRP6_CORE5_MODE=false
# Expose /debug/diagnostics (off by default)
# WOW_DEBUG_ENABLED=true

# --- JWT ---------------------------------------------------------------------
WOW_JWT_ISSUER=wow-backend
WOW_JWT_AUDIENCE=wow-web
WOW_JWT_EXPIRES_MINUTES=15
WOW_JWT_REFRESH_EXPIRES_DAYS=30

# --- Backend image -----------------------------------------------------------
# Image to pull (if using CI/published images)
WOW_BACKEND_IMAGE=ghcr.io/lucaswilliameufrasio/wow-server-backend
WOW_BACKEND_TAG=latest

# --- AzerothCore compose project name (do not change after first deploy) -----
WOW_ACORE_PROJECT=azerothcore-wotlk

# --- Realm address (set after first start) -----------------------------------
# Update with: ./wowctl set-realm <PUBLIC_IP> [localAddress]
# Or manually via SQL:
#   docker exec ac-database mysql -uroot -p"$WOW_MYSQL_PASSWORD" acore_auth \
#     -e "UPDATE realmlist SET address='<PUBLIC_IP>', localAddress='<LAN_IP>' WHERE id=1"

# --- Optional: Caddy reverse proxy (only if using a domain) ------------------
# Enable with: docker compose -f compose.yml -f caddy-compose.yml up -d
# WOW_CADY_DOMAIN=wow.example.com
# WOW_CADY_EMAIL=admin@example.com

# --- Backup ------------------------------------------------------------------
# WOW_BACKUP_DIR=/srv/wow/backups
# WOW_BACKUP_RETENTION_DAYS=30
# WOW_BACKUP_S3_ENDPOINT=https://s3.example.com
# WOW_BACKUP_S3_BUCKET=my-wow-backups
# WOW_BACKUP_S3_ACCESS_KEY=
# WOW_BACKUP_S3_SECRET_KEY=
#
# Scheduled backups (docker compose up wow-backup): cron schedule, daily 03:00 default.
# WOW_BACKUP_SCHEDULE=0 3 * * *

# --- Network ----------------------------------------------------------------
# NetBird or Tailscale IP for API access without Caddy
# WOW_API_BIND=100.64.0.1
