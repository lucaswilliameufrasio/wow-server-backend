FROM rust:1.97-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY mcp/Cargo.toml ./mcp/Cargo.toml

# Dummy sources so dependency compilation is cached; only the API package is
# needed in this image, so the workspace is built with -p rust-http-service.
RUN mkdir -p src && echo 'fn main() {}' > src/main.rs \
    && mkdir -p mcp/src && echo 'fn main() {}' > mcp/src/main.rs \
    && cargo build --release -p rust-http-service

COPY src ./src
COPY migrations ./migrations
RUN touch src/main.rs && cargo build --release -p rust-http-service

FROM debian:bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/rust-http-service /app/wow-server-backend
COPY --from=builder /app/migrations /app/migrations

RUN useradd -r -u 10001 appuser
USER appuser

EXPOSE 3000
ENV RUST_LOG=info
ENTRYPOINT ["/app/wow-server-backend"]
